<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ghost_game_orchestrator</name>
  <version>0.1.0</version>
  <description>State-machine orchestration and monitoring for the Find the Ghost application.</description>
  <maintainer email="yipeng.xia@hotmail.com">nvidia</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>builtin_interfaces</depend>
  <depend>controller_manager_msgs</depend>
  <depend>control_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>ghost_game_interfaces</depend>
  <depend>ament_index_python</depend>

  <!-- For the web dashboard's optional 3D robot model: expands the real
       arm URDF (xacro) and serves its meshes from zephyr_arm_description's
       own dependency chain. Falls back to a schematic skeleton if missing. -->
  <exec_depend>xacro</exec_depend>
  <exec_depend>zephyr_arm_description</exec_depend>
  <exec_depend>rebot_arm_rs_description</exec_depend>
  <exec_depend>omni_picker_description</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

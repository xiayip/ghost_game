<?xml version="1.0"?>
<package format="3">
  <name>ghost_game_gestures</name>
  <version>0.1.0</version>
  <description>Hand gesture classification and debounced interaction events from shared RGB images.</description>
  <maintainer email="yipeng.xia@hotmail.com">nvidia</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- MediaPipe Tasks is installed separately for the target Python/platform. -->
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
